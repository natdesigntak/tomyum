{
  "manifest_version": 3,
  "name": "Shopee Upload Assistant (Prototype)",
  "version": "0.1.0",
  "description": "Assist filling upload form from local metadata with manual confirmation.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Shopee Assistant"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.shopee.*/*"],
      "js": ["content.js"]
    }
  ]
}
